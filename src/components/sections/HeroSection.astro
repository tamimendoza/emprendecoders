---
import Badge from '@src/components/ui/Badge.astro';
import ScrollReveal from '@src/components/layout/ScrollReveal.astro';
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden px-4 sm:px-6 pt-20 pb-16 sm:pb-24">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="glow w-[500px] h-[500px] sm:w-[600px] sm:h-[600px] bg-primary top-[-200px] right-[-200px]"></div>
    <div class="glow w-[400px] h-[400px] sm:w-[500px] sm:h-[500px] bg-secondary bottom-[-100px] left-[-100px] opacity-30"></div>
    <div class="glow w-[200px] h-[200px] sm:w-[250px] sm:h-[250px] bg-accent top-1/3 left-1/4 opacity-[0.08]"></div>
  </div>
  <div class="relative w-full max-w-3xl mx-auto text-center flex flex-col items-center">
    <ScrollReveal>
      <Badge variant="accent" class="mb-6 sm:mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
        Estudio de desarrollo
      </Badge>
    </ScrollReveal>
    <ScrollReveal>
      <h1 class="text-[clamp(2rem,_5vw,_3.5rem)] font-extrabold leading-[1.1] tracking-tight mb-4 sm:mb-5">
        Servicios digitales <br />
        para <span class="text-gradient-brand">emprendedores</span>
      </h1>
    </ScrollReveal>
    <ScrollReveal>
      <p class="text-base sm:text-lg text-skin-secondary max-w-xl mx-auto leading-relaxed mb-10 sm:mb-12">
        Creamos aplicaciones y herramientas que resuelven problemas reales.
        Privacidad, simplicidad y control en cada producto.
      </p>
    </ScrollReveal>
    <slot />
  </div>
</section>
