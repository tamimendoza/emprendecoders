---
import ScrollReveal from '@src/components/layout/ScrollReveal.astro';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const audiences = [
  {
    icon: 'shield',
    title: 'Privacidad ante todo',
    desc: 'No querés que ninguna empresa tenga acceso a tus finanzas. Con Many todo queda en tu teléfono. Sin cuentas, sin sincronización, sin nube. Tu dinero, tu data, tu control.',
  },
  {
    icon: 'lock',
    title: 'Odias registrarte',
    desc: 'Cansado de crear cuentas, verificar emails y aceptar términos eternos. Descargás Many y ya está funcionando. Sin mails, sin contraseñas, sin humo.',
  },
  {
    icon: 'users',
    title: 'Finanzas múltiples',
    desc: 'Manejas varias cuentas, proyectos o presupuestos. Con los perfiles separados de Many podés tener todo organizado sin mezclar nada.',
  },
];

const iconPaths: Record<string, string> = {
  'shield': '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>',
  'lock': '<rect x="4" y="11" width="16" height="11" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/><circle cx="12" cy="16" r="1.5" fill="currentColor"/>',
  'users': '<rect x="5" y="9" width="6" height="8" rx="2"/><circle cx="8" cy="6" r="2.5"/><rect x="13" y="9" width="6" height="8" rx="2"/><circle cx="16" cy="6" r="2.5"/>',
};
---

<section class="px-4 sm:px-6 py-16 sm:py-20 bg-skin-surface text-skin-primary {className}" id="audience">
  <div class="mx-auto max-w-content">
    <ScrollReveal>
      <p class="text-xs font-semibold tracking-[0.08em] uppercase text-primary mb-3">
        Para quién es
      </p>
    </ScrollReveal>
    <ScrollReveal>
      <h2 class="text-[clamp(1.5rem,_3.5vw,_2.25rem)] font-extrabold tracking-tight mb-10 sm:mb-12">
        Hecha para personas como <span class="text-gradient">vos</span>
      </h2>
    </ScrollReveal>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
      {
        audiences.map((a) => (
          <ScrollReveal>
            <div class="p-6 sm:p-7 rounded-2xl border border-skin bg-skin-surface-2 card-hover hover:border-primary/20 hover:shadow-elevated">
              <div class="w-12 h-12 sm:w-14 sm:h-14 flex items-center justify-center rounded-xl bg-gradient-to-br from-primary/[0.12] to-primary/[0.04] text-primary mb-4 sm:mb-5" aria-hidden="true" set:html={`<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${iconPaths[a.icon]}</svg>`}>
              </div>
              <h3 class="text-base sm:text-lg font-bold mb-3">{a.title}</h3>
              <p class="text-xs sm:text-sm text-skin-secondary leading-relaxed">{a.desc}</p>
            </div>
          </ScrollReveal>
        ))
      }
    </div>
  </div>
</section>
